rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read/write their own profile
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Projects: owner only
    match /projects/{projectId} {
      allow read, write: if request.auth != null &&
        request.auth.uid == resource.data.ownerId;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.ownerId;
    }

    // Reports: owner only
    match /reports/{reportId} {
      allow read, write: if request.auth != null &&
        request.auth.uid == resource.data.ownerId;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.ownerId;
    }

    // User settings: keyed by userId, owner only
    match /userSettings/{userId} {
      allow read, write: if isOwner(userId);
    }

    // User usage: keyed by userId, owner only
    match /userUsage/{userId} {
      allow read: if isOwner(userId);
      // Write is done server-side via Cloud Function (no client write needed)
      allow write: if isOwner(userId);
    }

    // User profiles: owner only
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Feedback: authenticated users can create
    match /feedback/{docId} {
      allow create: if request.auth != null;
      allow read, write: if false; // no client reads/updates
    }
  }
}
